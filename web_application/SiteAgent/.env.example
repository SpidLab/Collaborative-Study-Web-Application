# Settings for the Site Agent. The setup script writes a real ".env" for you,
# but you can also copy this file to ".env" and fill it in by hand.

# Address of the collaboration server (your study coordinator gives you this).
SERVER_URL=https://collab.example.org

# First-time login code from the website (Settings -> "Connect my computer").
# After the first successful run the agent saves a token, so you can leave this
# blank afterwards.
ENROLL_CODE=

# (Optional) If you already have a long-lived token, paste it here instead.
AGENT_TOKEN=

# Top folder ON YOUR COMPUTER holding one sub-folder per dataset, each named like
# the phenotype you registered and containing a rawdata.csv (plus optional
# case_ids.txt / control_ids.txt). Examples:
#   macOS:    /Users/yourname/collab-data        (e.g. .../collab-data/eye_color/rawdata.csv)
#   Windows:  C:\Users\yourname\collab-data
HOST_DATA_DIR=/Users/yourname/collab-data

# (Advanced) Use a prebuilt image from a registry instead of building locally.
# Leave as-is to build from the included Dockerfile.
AGENT_IMAGE=collabstudy-agent:local
