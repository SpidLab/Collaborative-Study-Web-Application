# ============================================
# Collaborative Study Web Application
# Environment Variables Configuration
# ============================================
# 
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Location: web_application/Backend/FlaskApp/.env
# ============================================

# ============================================
# Flask Backend (app.py) - REQUIRED
# ============================================

# MongoDB Connection String (Main Database)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/test?retryWrites=true&w=majority

# Flask Server Port
PORT=5002

# Flask Secret Key (for sessions, JWT tokens)
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-to-random-string

# ============================================
# QC Controller Configuration
# ============================================

# QC Controller URL (used when orchestrator is disabled)
QC_CONTROLLER_URL=http://localhost:5001

# ============================================
# Kubernetes Orchestrator Configuration
# ============================================

# Enable/Disable Kubernetes Orchestrator
# Set to 'true' to use Kubernetes pods, 'false' to use direct QC Controller
USE_ORCHESTRATOR=false

# Orchestrator Server URL (Node.js server)
ORCHESTRATOR_URL=http://localhost:3000

# ============================================
# MongoDB Atlas Configuration (for QC Controller & Workers)
# ============================================
# These are used by:
# - QC Controller (qc_controller.py)
# - QC Worker Pods (qc_worker.py)
# - Orchestrator Server (server.js)

MONGO_USERNAME=CollaboratorDB
MONGO_PASSWORD=CollaboratorDB@123
MONGO_CLUSTER=collaboratordb.68hkp69.mongodb.net

# ============================================
# QC Controller Specific (Collaborator_Server/qc_controller.py)
# ============================================

# Default data file path (for initialization)
# Local: ./data/data_party_a.csv
# Docker: /app/data/data_party_a.csv
DEFAULT_DATA_FILE=./data/data_party_a.csv

# PCA Model directory path
PCA_MODEL_PATH=models

# ============================================
# LLM (one-page GWAS summary)
# ============================================
# Used by /api/collaboration/<uuid>/gwas-summary to write a privacy-preserving
# one-page summary from chi-square results. ONLY aggregated stats are sent.
OPENAI_API_KEY=
GWAS_SUMMARY_MODEL=gpt-4o-mini

# ============================================
# Email notifications (Gmail SMTP via App Password)
# ============================================
# Sends invitation / acceptance / results-ready emails. All sends are best-effort:
# if these are unset or wrong, the app still works — it just skips the email.
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-account@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
EMAIL_FROM=your-sender-account@gmail.com
EMAIL_FROM_NAME=Collaborative Study
# Base URL used for links inside emails (the FRONTEND site, not the API).
APP_BASE_URL=http://localhost:5173

# ============================================
# Orchestrator Server (ORCHISTRATION SERVER/server.js)
# ============================================
# These can be set in orchestrator's environment or Kubernetes config

# Kubernetes Namespace
# NAMESPACE=default

# Maximum concurrent pods
# MAX_PODS=10

# Warm Pool Size (number of ready pods to maintain)
# WARM_POOL_SIZE=3

# QC Worker Docker Image
# WORKER_IMAGE=qc-worker:latest
