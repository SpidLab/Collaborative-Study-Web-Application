#!/bin/bash
set -euxo pipefail

# Install Docker + Compose plugin (Amazon Linux 2023)
dnf update -y
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-aarch64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/collabstudy
mkdir -p "$APP_DIR"
cd "$APP_DIR"

# Fetch secrets from SSM
REGION="${region}"
MONGO_URI=$(aws ssm get-parameter --region "$REGION" --name "${mongo_uri_param}" --with-decryption --query Parameter.Value --output text)
SECRET_KEY=$(aws ssm get-parameter --region "$REGION" --name "${secret_key_param}" --with-decryption --query Parameter.Value --output text)
OPENAI_API_KEY=$(aws ssm get-parameter --region "$REGION" --name "${openai_param}" --with-decryption --query Parameter.Value --output text)
[ "$OPENAI_API_KEY" = "unset" ] && OPENAI_API_KEY=""

cat > "$APP_DIR/.env" <<EOF
API_IMAGE=${api_image}
WEB_IMAGE=${web_image}
DOMAIN=${domain}
MONGO_URI=$MONGO_URI
SECRET_KEY=$SECRET_KEY
OPENAI_API_KEY=$OPENAI_API_KEY
EOF

cat > "$APP_DIR/docker-compose.yml" <<'EOF'
${compose}
EOF

# Log in to ECR and start (images are pulled from ECR; nothing else to upload)
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${registry}"
docker compose --env-file "$APP_DIR/.env" -f "$APP_DIR/docker-compose.yml" pull || true
docker compose --env-file "$APP_DIR/.env" -f "$APP_DIR/docker-compose.yml" up -d
