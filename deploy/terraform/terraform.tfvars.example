# Copy this to terraform.tfvars and fill in your values.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is gitignored (it contains secrets). Then just run `terraform apply`.

region = "us-east-2"
# No domain needed — the server gets a constant HTTPS URL from its Elastic IP via
# sslip.io (e.g. https://3-21-0-0.sslip.io). See `terraform output url` after apply.

# MongoDB Atlas connection string (external managed cluster; free M0 is fine for pilot)
mongo_uri = "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# JWT + agent-token signing key. Generate a fresh one: openssl rand -hex 32
secret_key = "REPLACE_WITH_openssl_rand_hex_32"

# Optional: enables the GWAS AI summary
openai_api_key = ""

# Optional: email notifications (invitations / acceptance / results ready) via Gmail SMTP.
# Leave both empty to disable email entirely (the app still works without it).
# Create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords.
smtp_user = "noreply@gmail.com"   # e.g. "collaborativestudy.noreply@gmail.com"
smtp_pass = ""   # the 16-character Gmail App Password (NOT your account password)

# Restrict SSH to your IP (or leave "" to disable SSH; SSM Session Manager still works)
ssh_cidr = ""
# key_name = "my-ec2-keypair"   # only if you set ssh_cidr and want SSH
